<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Vulkan 1.1 requerido para la ruta Zink/HDR; GL4ES funciona sin él -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".LauncherApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.MCLauncher"
        android:appCategory="game"
        android:isGame="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true">

        <!-- Game Mode / perfiles de rendimiento del fabricante (HyperOS Game Turbo, etc.) -->
        <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MicrosoftLoginActivity"
            android:exported="false"
            android:label="Iniciar sesión con Microsoft" />

        <!-- La JVM HotSpot corre en un proceso aparte: si el juego crashea
             o hace System.exit(), el launcher sigue vivo. -->
        <activity
            android:name=".ui.GameActivity"
            android:process=":game"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:colorMode="hdr"
            android:resizeableActivity="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@style/Theme.MCLauncher.Fullscreen" />

        <!-- Motor Zalith/Pojav (libpojavexec): mismo proceso :game, una JVM por proceso -->
        <activity
            android:name=".ui.ZalithGameActivity"
            android:process=":game"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:colorMode="hdr"
            android:resizeableActivity="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@style/Theme.MCLauncher.Fullscreen" />

        <!-- Instalador oficial de Forge/NeoForge, en su propio proceso HotSpot -->
        <activity
            android:name=".ui.InstallerActivity"
            android:process=":installer"
            android:exported="false"
            android:excludeFromRecents="true" />
    </application>
</manifest>
